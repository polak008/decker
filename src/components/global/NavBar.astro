---
const pathname = Astro.url.pathname;
import Link from "../elements/Link.astro"

const nav = [
    { title: "/home", href: "/" },
    { title: "/projects", href: "/projects" },
    { title: "/about", href: "/about" },
    { title: "/writing", href: "/blog" },
    { title: "/contact", href: "/contact" },
]
---

<nav class="bg-base-900 flex flex-row flex-wrap sticky top-0">
    {
        nav.map((navLink) => {
            const href = import.meta.env.BASE_URL + navLink.href.replace(/^\//, "");
            const isActive = navLink.href === "/" ? pathname === import.meta.env.BASE_URL || pathname === import.meta.env.BASE_URL.slice(0, -1) : pathname.startsWith(href);
        return (
            <Link
                variant={'nav'}
                href={href}
                text={navLink.title}
                aria-current={isActive ? "page" : undefined}
                class={isActive ? "bg-base-950 border-t-2 border-base-900" : "" }
            />
        )})
    }
</nav>
